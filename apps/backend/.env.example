# Copia este archivo a .env y rellena con tus datos de Postgres.
# En Windows: copy .env.example .env

# Conexión a PostgreSQL
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD?schema=public
# Desarrollo local: gastro_management_dev
# Pruebas locales: gastro_management_test
# Nunca copies la DATABASE_URL de Railway como DATABASE_URL local.
DATABASE_URL="postgresql://postgres:tu_password@127.0.0.1:5432/gastro_management_dev?schema=public"

# Puerto del servidor Express (opcional, por defecto 3000)
PORT=3000
