# Copia este archivo a .env y rellena con tus datos de Postgres.
# En Windows: copy .env.example .env

# Conexión a PostgreSQL
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD?schema=public
# Desarrollo local: gastro_management_dev
# Pruebas locales: gastro_management_test
# Nunca copies la DATABASE_URL de Railway como DATABASE_URL local.
DATABASE_URL="postgresql://postgres:tu_password@127.0.0.1:5432/gastro_management_dev?schema=public"

# Puerto del servidor Express (opcional, por defecto 3000)
PORT=3000

# Almacenamiento de imágenes del menú (solo desarrollo local en esta fase).
# El directorio debe estar fuera del repositorio. Si se omite MEDIA_LOCAL_ROOT,
# se usa un directorio GastroManagement/media bajo los datos locales del usuario.
# Railway/producción debe usar un futuro driver de object storage; el backend
# rechaza deliberadamente el driver local cuando NODE_ENV=production.
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT="C:/gastro-management/media"
# Base pública opcional. Vacía devuelve rutas relativas /menu-media/files/...
MEDIA_PUBLIC_BASE_URL="http://localhost:3001"
