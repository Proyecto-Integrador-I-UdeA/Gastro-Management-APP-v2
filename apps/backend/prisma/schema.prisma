generator client {
  provider = "prisma-client-js"
  seed     = "ts-node prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Supplier {
  id            Int       @id @default(autoincrement())
  internalCode  String    @unique
  name          String
  taxId         String
  phone         String
  address       String
  contactPerson String
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  products      Product[]

  @@map("suppliers")
}

model IngredientCatalog {
  id              Int       @id @default(autoincrement())
  name            String    @unique
  category        String?
  caloriesPer100g Float?
  carbsPer100g    Float?
  fatPer100g      Float?
  proteinPer100g  Float?
  sugarPer100g    Float?
  sodiumPer100g   Float?
  isSystem        Boolean   @default(false)
  products        Product[]
}

model Product {
  id                 Int                 @id @default(autoincrement())
  internalCode       String              @unique
  name               String
  category           String              @default("")
  isIngredient       Boolean             @default(false)
  isSupply           Boolean             @default(false)
  isFinishedProduct  Boolean             @default(false)
  presentation       String
  inputUnit          String              @default("g")
  inputUnitQuantity  Float               @default(1)
  minStock           Float
  maxStock           Float
  currentStock       Float               @default(0)
  unitCost           Float               @default(0)
  active             Boolean             @default(true)
  supplierId         Int
  caloriesPer100g    Float?
  carbsPer100g       Float?
  fatPer100g         Float?
  proteinPer100g     Float?
  sodiumPer100g      Float?
  sugarPer100g       Float?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  unitOfMeasure      ProductBaseUnit     @default(g)
  catalogId          Int?
  isSeedProduct      Boolean             @default(false)
  MenuItemComponent  MenuItemComponent[]
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  kitchenConsumptionItems KitchenInventoryConsumptionItem[]
  physicalCountItems InventoryPhysicalCountItem[]
  catalog            IngredientCatalog?  @relation(fields: [catalogId], references: [id])
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  recipeItems        RecipeItem[]        @relation("ProductRecipeItems")

  @@map("products")
}

model Warehouse {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  description       String?
  /// Referencia administrativa heredada; no determina los usos operativos.
  isMain            Boolean             @default(false)
  purchaseReceiving Boolean             @default(false)
  kitchenConsumption Boolean            @default(false)
  barConsumption    Boolean             @default(false)
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  inventories       Inventory[]
  movementsAsDest   InventoryMovement[] @relation("DestinationWarehouse")
  movementsAsSource InventoryMovement[] @relation("SourceWarehouse")
  kitchenConsumptions KitchenInventoryConsumption[]
  physicalCounts InventoryPhysicalCount[]

  @@map("warehouses")
}

model Inventory {
  id          Int       @id @default(autoincrement())
  quantity    Float     @default(0)
  productId   Int
  warehouseId Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@map("inventories")
}

model InventoryMovement {
  id                     Int          @id @default(autoincrement())
  type                   MovementType
  quantity               Float
  unitCost               Decimal?     @db.Decimal(10, 2)
  expirationDate         DateTime?
  notes                  String?
  productId              Int
  sourceWarehouseId      Int?
  destinationWarehouseId Int?
  userId                 Int
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @default(now()) @updatedAt
  destinationWarehouse   Warehouse?   @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  product                Product      @relation(fields: [productId], references: [id])
  sourceWarehouse        Warehouse?   @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  user                   User         @relation(fields: [userId], references: [id])
  kitchenConsumptionItem KitchenInventoryConsumptionItem?
  physicalCountItem InventoryPhysicalCountItem?

  @@map("inventory_movements")
}

model User {
  id                    Int                 @id @default(autoincrement())
  email                 String              @unique
  passwordHash          String
  fullName              String?
  roleId                Int?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @default(now()) @updatedAt
  active                Boolean             @default(true)
  movements             InventoryMovement[]
  createdMenuItemPrices MenuItemPrice[]
  uploadedMediaAssets   MediaAsset[]
  openedSalesOrders     SalesOrder[]        @relation("SalesOrderOpenedBy")
  settledSalesOrders    SalesOrder[]        @relation("SalesOrderSettledBy")
  accountRequestedSalesOrders SalesOrder[]  @relation("SalesOrderAccountRequestedBy")
  cancelledSalesOrders  SalesOrder[]        @relation("SalesOrderCancelledBy")
  acknowledgedSalesOrderCancellations SalesOrder[] @relation("SalesOrderCancellationAcknowledgedBy")
  addedSalesOrderItems  SalesOrderItem[]     @relation("SalesOrderItemAddedBy")
  dispatchedKitchenDispatches KitchenDispatch[] @relation("KitchenDispatchDispatchedBy")
  startedKitchenDispatches KitchenDispatch[] @relation("KitchenDispatchStartedBy")
  readiedKitchenDispatches KitchenDispatch[] @relation("KitchenDispatchReadyBy")
  deliveredKitchenDispatches KitchenDispatch[] @relation("KitchenDispatchDeliveredBy")
  generatedSalesPreInvoices SalesPreInvoice[] @relation("SalesPreInvoiceGeneratedBy")
  openedCashSessions CashSession[] @relation("CashSessionOpenedBy")
  closedCashSessions CashSession[] @relation("CashSessionClosedBy")
  receivedCashPayments CashPayment[] @relation("CashPaymentReceivedBy")
  updatedCashServiceConfigs CashServiceConfig[] @relation("CashServiceConfigUpdatedBy")
  cashServiceConfigAudits CashServiceConfigAudit[] @relation("CashServiceConfigAuditChangedBy")
  updatedGlobalWasteConfigs           GlobalWasteConfig[]      @relation("GlobalWasteConfigUpdatedBy")
  globalWasteConfigAudits             GlobalWasteConfigAudit[] @relation("GlobalWasteConfigAuditChangedBy")
  createdPhysicalCounts InventoryPhysicalCount[] @relation("PhysicalCountCreatedBy")
  updatedPhysicalCounts InventoryPhysicalCount[] @relation("PhysicalCountUpdatedBy")
  postedPhysicalCounts InventoryPhysicalCount[] @relation("PhysicalCountPostedBy")
  cancelledPhysicalCounts InventoryPhysicalCount[] @relation("PhysicalCountCancelledBy")
  createdReservations     Reservation[]        @relation("ReservationCreatedBy")
  updatedReservations     Reservation[]        @relation("ReservationUpdatedBy")
  confirmedReservations   Reservation[]        @relation("ReservationConfirmedBy")
  cancelledReservations   Reservation[]        @relation("ReservationCancelledBy")
  completedReservations   Reservation[]        @relation("ReservationCompletedBy")
  reservationHistory      ReservationHistory[] @relation("ReservationHistoryActor")
  role                  Role?               @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Recipe {
  id                 Int                 @id @default(autoincrement())
  internalCode       String              @unique
  active             Boolean             @default(true)
  name               String
  description        String?
  batchQuantity      Float
  portions           Int
  totalCost          Decimal?            @db.Decimal(10, 2)
  createdAt          DateTime            @default(now())
  caloriesPerPortion Float?
  carbsPerPortion    Float?
  fatPerPortion      Float?
  nutritionScore     Float?
  proteinPerPortion  Float?
  sodiumPerPortion   Float?
  sugarPerPortion    Float?
  costClassification String?
  macroDominance     String?
  nutritionRole      String?
  MenuItemComponent  MenuItemComponent[]
  items              RecipeItem[]        @relation("ParentRecipe")
  usedAsSubRecipe    RecipeItem[]        @relation("SubRecipeReference")
  processes          RecipeProcess[]
  kitchenConsumptionItems KitchenInventoryConsumptionItem[]

  @@map("recipes")
}

model RecipeItem {
  id          Int      @id @default(autoincrement())
  recipeId    Int
  productId   Int?
  quantity    Float
  unitCost    Decimal  @db.Decimal(10, 2)
  totalCost   Decimal  @db.Decimal(10, 2)
  subRecipeId Int?
  product     Product? @relation("ProductRecipeItems", fields: [productId], references: [id])
  recipe      Recipe   @relation("ParentRecipe", fields: [recipeId], references: [id])
  subRecipe   Recipe?  @relation("SubRecipeReference", fields: [subRecipeId], references: [id])

  @@map("recipe_items")
}

model RecipeProcess {
  id              Int     @id @default(autoincrement())
  recipeId        Int
  name            String
  processType     String
  duration        Float
  operators       Int
  stepDescription String?
  stepOrder       Int     @default(0) @map("order")
  recipe          Recipe  @relation(fields: [recipeId], references: [id])

  @@map("recipe_processes")
}

model Cost {
  id           Int    @id @default(autoincrement())
  name         String
  type         String
  monthlyValue Float

  @@map("costs")
}

model Config {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("config")
}

model GlobalWasteConfig {
  id           Int                      @id @default(1)
  wastePercent Decimal                  @default(0) @db.Decimal(5, 2)
  updatedById  Int?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @default(now()) @updatedAt
  updatedBy    User?                    @relation("GlobalWasteConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  audits       GlobalWasteConfigAudit[]

  @@map("global_waste_config")
}

model GlobalWasteConfigAudit {
  id              Int               @id @default(autoincrement())
  configId        Int
  previousPercent Decimal           @db.Decimal(5, 2)
  newPercent      Decimal           @db.Decimal(5, 2)
  changedById     Int
  changedAt       DateTime          @default(now())
  config          GlobalWasteConfig @relation(fields: [configId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  changedBy       User              @relation("GlobalWasteConfigAuditChangedBy", fields: [changedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([configId, changedAt])
  @@map("global_waste_config_audits")
}

model OperationalCostConfig {
  id                Int      @id @default(autoincrement())
  month             String
  fixedCosts        Float
  variableCosts     Float
  payroll           Float
  monthlyProduction Float?
  createdAt         DateTime @default(now())

  @@map("other_costs")
}

model VariableCosts {
  id    Int    @id @default(autoincrement())
  month String

  packagingCost             Float @default(0)
  wastePercent              Float @default(0)
  paymentProcessingPercent  Float @default(0)
  platformCommissionPercent Float @default(0)
  extraVariableCost         Float @default(0)

  createdAt DateTime @default(now())

  @@map("variable_costs")
}

model CostCategory {
  id             Int      @id @default(autoincrement())
  month          String
  production     Float
  operation      Float
  distribution   Float
  commercial     Float
  administration Float
  createdAt      DateTime @default(now())

  @@map("cost_categories")
}

model MenuCategory {
  id             Int        @id @default(autoincrement())
  name           String
  normalizedName String     @unique
  description    String?
  displayOrder   Int        @default(0)
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt
  menuItems      MenuItem[]

  @@index([active, displayOrder])
  @@map("menu_categories")
}

model MenuItem {
  id                 Int                 @id @default(autoincrement())
  name               String
  description        String?
  hasDrink           Boolean             @default(false)
  hasDessert         Boolean             @default(false)
  active             Boolean             @default(true)
  kind               MenuItemKind        @default(STANDARD)
  available          Boolean             @default(true)
  includedItemsText  String?             @db.VarChar(500)
  createdAt          DateTime            @default(now())
  caloriesPerPortion Float?
  carbsPerPortion    Float?
  fatPerPortion      Float?
  nutritionScore     Float?
  proteinPerPortion  Float?
  sodiumPerPortion   Float?
  sugarPerPortion    Float?
  totalCost          Decimal?            @db.Decimal(10, 2)
  categoryId         Int?
  imageAssetId       Int?                @unique
  category           MenuCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  imageAsset         MediaAsset?          @relation(fields: [imageAssetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  components         MenuItemComponent[]
  prices             MenuItemPrice[]
  salesOrderItems    SalesOrderItem[]

  @@index([categoryId])
}

model MediaAsset {
  id                 Int              @id @default(autoincrement())
  storageKey         String           @unique
  mimeType           String
  byteSize           Int
  width              Int
  height             Int
  checksumSha256     String           @db.Char(64)
  status             MediaAssetStatus @default(UNATTACHED)
  uploadedById       Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt
  attachedAt         DateTime?
  cleanupRequestedAt DateTime?
  cleanupAttempts    Int              @default(0)
  lastCleanupError   String?
  uploadedBy         User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  menuItem           MenuItem?

  @@index([status, createdAt])
  @@map("media_assets")
}

model MenuItemPrice {
  id                   Int       @id @default(autoincrement())
  menuItemId           Int
  baseCostSnapshot     Decimal   @db.Decimal(14, 4)
  indirectCostSnapshot Decimal   @db.Decimal(14, 4)
  totalCostSnapshot    Decimal   @db.Decimal(14, 4)
  marginRate           Decimal   @db.Decimal(9, 6)
  taxRate              Decimal   @db.Decimal(9, 6)
  priceBeforeTax       Decimal   @db.Decimal(14, 4)
  taxAmount            Decimal   @db.Decimal(14, 4)
  calculatedAmount     Decimal   @db.Decimal(14, 4)
  roundingIncrement    Decimal   @db.Decimal(12, 2)
  amount               Decimal   @db.Decimal(12, 2)
  currency             String    @default("COP") @db.VarChar(3)
  taxIncluded          Boolean   @default(true)
  calculationVersion   String    @db.VarChar(32)
  createdById          Int
  validFrom            DateTime
  validUntil           DateTime?
  createdAt            DateTime  @default(now())
  menuItem             MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy            User      @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  salesOrderItems      SalesOrderItem[]

  @@index([menuItemId, validFrom])
  @@map("menu_item_prices")
}

model DiningTable {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  area        String?
  capacity    Int
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  salesOrders SalesOrder[]
  reservations Reservation[]

  @@map("dining_tables")
}

model Reservation {
  id                 Int               @id @default(autoincrement())
  customerName       String            @db.VarChar(200)
  phone              String            @db.VarChar(50)
  email              String?           @db.VarChar(320)
  reservationType    ReservationType
  scheduledAt        DateTime
  guestCount         Int
  preferredArea      String?           @db.VarChar(120)
  diningTableId      Int?
  reason             String            @db.VarChar(500)
  notes              String?
  status             ReservationStatus @default(PENDING)
  isVip              Boolean           @default(false)
  createdById        Int
  updatedById        Int
  confirmedAt        DateTime?
  confirmedById      Int?
  cancelledAt        DateTime?
  cancelledById      Int?
  cancellationReason String?           @db.VarChar(500)
  lateCancellation   Boolean           @default(false)
  completedAt        DateTime?
  completedById      Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt
  diningTable        DiningTable?       @relation(fields: [diningTableId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy          User               @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updatedBy          User               @relation("ReservationUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  confirmedBy        User?              @relation("ReservationConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cancelledBy        User?              @relation("ReservationCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  completedBy        User?              @relation("ReservationCompletedBy", fields: [completedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  history            ReservationHistory[]

  @@index([scheduledAt])
  @@index([status, scheduledAt])
  @@index([diningTableId])
  @@index([reservationType, scheduledAt])
  @@map("reservations")
}

model ReservationHistory {
  id                  Int                      @id @default(autoincrement())
  reservationId       Int
  action              ReservationHistoryAction
  actorId             Int
  occurredAt          DateTime                 @default(now())
  note                String?                  @db.VarChar(500)
  previousScheduledAt DateTime?
  newScheduledAt      DateTime?
  previousStatus      ReservationStatus?
  newStatus           ReservationStatus?
  reservation         Reservation              @relation(fields: [reservationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor               User                     @relation("ReservationHistoryActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([reservationId, occurredAt, id])
  @@map("reservation_history")
}

model SalesOrder {
  id              Int               @id @default(autoincrement())
  diningTableId   Int
  status          SalesOrderStatus  @default(OPEN)
  openedById      Int
  openedAt        DateTime          @default(now())
  guestCount      Int?
  billRequestedAt DateTime?
  settledAt       DateTime?
  settledById     Int?
  paymentStatus   SalesPaymentStatus @default(UNPAID)
  accountRequestedAt DateTime?
  accountRequestedById Int?
  suggestedServicePercentSnapshot Decimal? @db.Decimal(5, 2)
  voidedAt        DateTime?
  cancelledById   Int?
  cancellationReason String?             @db.VarChar(500)
  cancellationAcknowledgedAt DateTime?
  cancellationAcknowledgedById Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  diningTable     DiningTable       @relation(fields: [diningTableId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  openedBy        User              @relation("SalesOrderOpenedBy", fields: [openedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  settledBy       User?             @relation("SalesOrderSettledBy", fields: [settledById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  accountRequestedBy User?          @relation("SalesOrderAccountRequestedBy", fields: [accountRequestedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cancelledBy     User?             @relation("SalesOrderCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cancellationAcknowledgedBy User?  @relation("SalesOrderCancellationAcknowledgedBy", fields: [cancellationAcknowledgedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items           SalesOrderItem[]
  kitchenDispatches KitchenDispatch[]
  preInvoices     SalesPreInvoice[]

  @@index([diningTableId])
  @@index([status])
  @@index([status, cancellationAcknowledgedAt])
  @@map("sales_orders")
}

model SalesPreInvoice {
  id                         Int              @id @default(autoincrement())
  salesOrderId               Int
  subtotalSnapshot           Decimal          @db.Decimal(14, 2)
  salesAmountSnapshot        Decimal          @db.Decimal(14, 2)
  consumptionTaxAmountSnapshot Decimal        @db.Decimal(14, 2)
  suggestedServicePercentSnapshot Decimal      @db.Decimal(5, 2)
  serviceAccepted            Boolean
  servicePercentSnapshot     Decimal          @db.Decimal(5, 2)
  serviceAmountSnapshot      Decimal          @db.Decimal(14, 2)
  totalSnapshot              Decimal          @db.Decimal(14, 2)
  status                     SalesPreInvoiceStatus @default(ACTIVE)
  generatedById              Int
  generatedAt                DateTime         @default(now())
  replacedAt                 DateTime?
  salesOrder                 SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  generatedBy                User             @relation("SalesPreInvoiceGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payments                   CashPayment[]

  @@index([salesOrderId, status], map: "sales_pre_invoices_order_status_idx")
  @@map("sales_pre_invoices")
}

model CashRegister {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  sessions    CashSession[]

  @@map("cash_registers")
}

model CashSession {
  id             Int             @id @default(autoincrement())
  cashRegisterId Int
  status         CashSessionStatus @default(OPEN)
  openedById     Int
  openedAt       DateTime        @default(now())
  openingCash    Decimal         @db.Decimal(14, 2)
  closedById     Int?
  closedAt       DateTime?
  expectedCash   Decimal?        @db.Decimal(14, 2)
  countedCash    Decimal?        @db.Decimal(14, 2)
  difference     Decimal?        @db.Decimal(14, 2)
  cashRegister   CashRegister    @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  openedBy       User            @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  closedBy       User?           @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payments       CashPayment[]

  @@index([cashRegisterId, status], map: "cash_sessions_register_status_idx")
  @@map("cash_sessions")
}

model CashPayment {
  id             Int          @id @default(autoincrement())
  preInvoiceId   Int
  cashSessionId  Int
  method         CashPaymentMethod
  amount         Decimal      @db.Decimal(14, 2)
  salesAmount    Decimal      @db.Decimal(14, 2)
  consumptionTaxAmount Decimal @db.Decimal(14, 2)
  serviceAmount  Decimal      @db.Decimal(14, 2)
  amountTendered Decimal?     @db.Decimal(14, 2)
  change         Decimal      @default(0) @db.Decimal(14, 2)
  idempotencyKey String       @unique @db.VarChar(120)
  receivedById   Int
  receivedAt     DateTime     @default(now())
  preInvoice     SalesPreInvoice @relation(fields: [preInvoiceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cashSession    CashSession  @relation(fields: [cashSessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receivedBy     User         @relation("CashPaymentReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([preInvoiceId, receivedAt], map: "cash_payments_invoice_receivedAt_idx")
  @@index([cashSessionId, method, receivedAt], map: "cash_payments_session_method_receivedAt_idx")
  @@map("cash_payments")
}

model CashServiceConfig {
  id            Int      @id @default(1)
  servicePercent Decimal  @default(0) @db.Decimal(5, 2)
  updatedById   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  updatedBy     User?    @relation("CashServiceConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  audits        CashServiceConfigAudit[]

  @@map("cash_service_config")
}

model CashServiceConfigAudit {
  id             Int              @id @default(autoincrement())
  configId       Int
  previousPercent Decimal         @db.Decimal(5, 2)
  newPercent     Decimal          @db.Decimal(5, 2)
  changedById    Int
  changedAt      DateTime         @default(now())
  config         CashServiceConfig @relation(fields: [configId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  changedBy      User             @relation("CashServiceConfigAuditChangedBy", fields: [changedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([configId, changedAt], map: "cash_service_config_audits_config_changedAt_idx")
  @@map("cash_service_config_audits")
}

model SalesOrderItem {
  id                  Int           @id @default(autoincrement())
  salesOrderId        Int
  menuItemId          Int
  menuItemPriceId     Int
  menuItemNameSnapshot String
  menuCategoryIdSnapshot Int?
  menuCategoryNameSnapshot String?
  quantity            Int
  specialInstructions String?       @db.VarChar(500)
  unitPriceSnapshot   Decimal       @db.Decimal(12, 2)
  unitSalesAmountSnapshot Decimal   @db.Decimal(12, 2)
  unitConsumptionTaxAmountSnapshot Decimal @db.Decimal(12, 2)
  currencySnapshot    String        @db.VarChar(3)
  taxIncludedSnapshot Boolean
  addedById           Int
  parentItemId        Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now()) @updatedAt
  salesOrder          SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  menuItem            MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  menuItemPrice       MenuItemPrice @relation(fields: [menuItemPriceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  addedBy             User          @relation("SalesOrderItemAddedBy", fields: [addedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parentItem          SalesOrderItem? @relation("SalesOrderItemAdditions", fields: [parentItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  additions           SalesOrderItem[] @relation("SalesOrderItemAdditions")
  kitchenDispatchItem KitchenDispatchItem?

  @@index([salesOrderId])
  @@index([menuItemId])
  @@index([menuCategoryIdSnapshot])
  @@index([parentItemId])
  @@map("sales_order_items")
}

model KitchenDispatch {
  id                      Int                   @id @default(autoincrement())
  salesOrderId            Int
  status                  KitchenDispatchStatus @default(NEXT)
  dispatchedById          Int
  dispatchedAt            DateTime              @default(now())
  prepTimeMinutesSnapshot Int                   @default(15)
  targetReadyAt           DateTime
  startedAt               DateTime?
  startedById             Int?
  readyAt                 DateTime?
  readyById               Int?
  deliveredAt             DateTime?
  deliveredById           Int?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt
  salesOrder              SalesOrder            @relation(fields: [salesOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dispatchedBy            User                  @relation("KitchenDispatchDispatchedBy", fields: [dispatchedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  startedBy               User?                 @relation("KitchenDispatchStartedBy", fields: [startedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  readyBy                 User?                 @relation("KitchenDispatchReadyBy", fields: [readyById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deliveredBy             User?                 @relation("KitchenDispatchDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items                   KitchenDispatchItem[]
  inventoryConsumption    KitchenInventoryConsumption?

  @@index([salesOrderId])
  @@index([status, dispatchedAt, id])
  @@index([dispatchedById, status, deliveredAt])
  @@index([deliveredAt])
  @@map("kitchen_dispatches")
}

model KitchenDispatchItem {
  id                          Int                   @id @default(autoincrement())
  kitchenDispatchId           Int
  salesOrderItemId            Int                   @unique
  parentDispatchItemId        Int?
  itemNameSnapshot            String
  quantitySnapshot            Int
  specialInstructionsSnapshot String?               @db.VarChar(500)
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @default(now()) @updatedAt
  kitchenDispatch             KitchenDispatch       @relation(fields: [kitchenDispatchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  salesOrderItem              SalesOrderItem         @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parentDispatchItem          KitchenDispatchItem?   @relation("KitchenDispatchItemAdditions", fields: [parentDispatchItemId, kitchenDispatchId], references: [id, kitchenDispatchId], onDelete: Restrict, onUpdate: Cascade)
  additions                   KitchenDispatchItem[]  @relation("KitchenDispatchItemAdditions")
  inventoryConsumptionItems   KitchenInventoryConsumptionItem[]

  @@index([kitchenDispatchId])
  @@index([parentDispatchItemId])
  @@unique([id, kitchenDispatchId])
  @@map("kitchen_dispatch_items")
}

model KitchenInventoryConsumption {
  id                   Int                               @id @default(autoincrement())
  kitchenDispatchId    Int                               @unique
  warehouseId          Int?
  wastePercentSnapshot Decimal                           @db.Decimal(5, 2)
  theoreticalCost      Decimal                           @db.Decimal(18, 4)
  wasteCost            Decimal                           @db.Decimal(18, 4)
  totalCost            Decimal                           @db.Decimal(18, 4)
  issues               Json?
  createdAt            DateTime                          @default(now())
  kitchenDispatch      KitchenDispatch                   @relation(fields: [kitchenDispatchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouse            Warehouse?                        @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items                KitchenInventoryConsumptionItem[]

  @@index([warehouseId, createdAt])
  @@map("kitchen_inventory_consumptions")
}

model KitchenInventoryConsumptionItem {
  id                    Int                         @id @default(autoincrement())
  consumptionId         Int
  kitchenDispatchItemId Int
  productId             Int
  recipeId              Int?
  inventoryMovementId   Int                         @unique
  theoreticalQuantity   Decimal                     @db.Decimal(18, 6)
  adjustedQuantity      Decimal                     @db.Decimal(18, 6)
  unit                  ProductBaseUnit
  unitCostSnapshot      Decimal                     @db.Decimal(18, 6)
  theoreticalCost       Decimal                     @db.Decimal(18, 4)
  wasteCost             Decimal                     @db.Decimal(18, 4)
  totalCost             Decimal                     @db.Decimal(18, 4)
  createdAt             DateTime                    @default(now())
  consumption           KitchenInventoryConsumption @relation(fields: [consumptionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  kitchenDispatchItem   KitchenDispatchItem         @relation(fields: [kitchenDispatchItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product               Product                     @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recipe                Recipe?                     @relation(fields: [recipeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  inventoryMovement     InventoryMovement           @relation(fields: [inventoryMovementId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([consumptionId, kitchenDispatchItemId, productId])
  @@index([productId, createdAt])
  @@index([recipeId])
  @@map("kitchen_inventory_consumption_items")
}

model MenuItemComponent {
  id         Int      @id @default(autoincrement())
  menuItemId Int
  productId  Int?
  recipeId   Int?
  quantity   Float
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  product    Product? @relation(fields: [productId], references: [id])
  recipe     Recipe?  @relation(fields: [recipeId], references: [id])
}

enum MovementType {
  PURCHASE
  TRANSFER
  WASTE
  CONSUMPTION
  ADJUSTMENT
}

enum InventoryPhysicalCountStatus {
  DRAFT
  POSTED
  CANCELLED
}

model InventoryPhysicalCount {
  id Int @id @default(autoincrement())
  warehouseId Int
  status InventoryPhysicalCountStatus @default(DRAFT)
  reason String @default("PHYSICAL_COUNT")
  notes String?
  createdById Int
  updatedById Int
  postedById Int?
  cancelledById Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  postedAt DateTime?
  cancelledAt DateTime?
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User @relation("PhysicalCountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("PhysicalCountUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  postedBy User? @relation("PhysicalCountPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledBy User? @relation("PhysicalCountCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  items InventoryPhysicalCountItem[]

  @@index([warehouseId, createdAt])
  @@index([status, createdAt])
  @@map("inventory_physical_counts")
}

model InventoryPhysicalCountItem {
  id Int @id @default(autoincrement())
  physicalCountId Int
  productId Int
  systemQuantitySnapshot Float
  countedQuantity Float?
  varianceQuantity Float?
  unit ProductBaseUnit
  // Provisional en DRAFT; se fija con el costo autoritativo al publicar.
  unitCostSnapshot Decimal @db.Decimal(24, 12)
  estimatedValueVariance Decimal? @db.Decimal(30, 12)
  inventoryMovementId Int? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  physicalCount InventoryPhysicalCount @relation(fields: [physicalCountId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryMovement InventoryMovement? @relation(fields: [inventoryMovementId], references: [id], onDelete: Restrict)

  @@unique([physicalCountId, productId])
  @@map("inventory_physical_count_items")
}

/// Coincide con el tipo PostgreSQL `ProductBaseUnit` creado en `20260326160000_product_unit_base_enum`.
enum ProductBaseUnit {
  g
  ml
  und
}

