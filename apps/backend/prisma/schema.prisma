generator client {
  provider = "prisma-client-js"
  seed     = "ts-node prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Supplier {
  id            Int       @id @default(autoincrement())
  internalCode  String    @unique
  name          String
  taxId         String
  phone         String
  address       String
  contactPerson String
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  products      Product[]

  @@map("suppliers")
}

model Product {
  id                 Int                 @id @default(autoincrement())
  internalCode       String              @unique
  name               String
  category           String              @default("")
  isIngredient       Boolean             @default(false)
  isSupply           Boolean             @default(false)
  isFinishedProduct  Boolean             @default(false)
  presentation       String
  /// Base de medida (enum nativo en BD tras migración `20260326160000_product_unit_base_enum`).
  unitOfMeasure      ProductBaseUnit     @default(g)
  inputUnit          String              @default("g")
  inputUnitQuantity  Float               @default(1)
  minStock           Float
  maxStock           Float
  currentStock       Float               @default(0)
  unitCost           Float               @default(0)
  // Información nutricional (por 100g / 100ml)
  caloriesPer100g    Float? // kcal
  fatPer100g         Float? // g
  carbsPer100g       Float? // g
  proteinPer100g     Float? // g
  sodiumPer100g      Float? // mg
  sugarPer100g       Float? // g
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  supplierId         Int
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  recipeItems        RecipeItem[]
  MenuItemComponent  MenuItemComponent[]

  @@map("products")
}

model Warehouse {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  description       String?
  /// Solo una bodega puede ser principal (entradas por compra).
  isMain            Boolean             @default(false)
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  inventories       Inventory[]
  movementsAsDest   InventoryMovement[] @relation("DestinationWarehouse")
  movementsAsSource InventoryMovement[] @relation("SourceWarehouse")

  @@map("warehouses")
}

model Inventory {
  id          Int       @id @default(autoincrement())
  quantity    Float     @default(0)
  productId   Int
  warehouseId Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@map("inventories")
}

model InventoryMovement {
  id                       Int          @id @default(autoincrement())
  type                     MovementType
  quantity                 Float
  unitCost                 Decimal?     @db.Decimal(10, 2)
  expirationDate           DateTime?
  notes                    String?
  productId                Int
  sourceWarehouseId        Int?
  destinationWarehouseId   Int?
  userId                   Int
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @default(now()) @updatedAt
  destinationWarehouse     Warehouse?   @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  product                  Product      @relation(fields: [productId], references: [id])
  sourceWarehouse          Warehouse?   @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  user                     User         @relation(fields: [userId], references: [id])

  @@map("inventory_movements")
}

model User {
  id           Int                 @id @default(autoincrement())
  email        String              @unique
  passwordHash String
  fullName     String?
  roleId       Int?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt
  active       Boolean             @default(true)
  movements    InventoryMovement[]
  role         Role?               @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Recipe {
  id                Int                 @id @default(autoincrement())
  internalCode      String              @unique
  active            Boolean             @default(true)
  name              String
  description       String?
  batchQuantity     Float
  portions          Int
  totalCost         Decimal?            @db.Decimal(10, 2)
  createdAt         DateTime            @default(now())
  items             RecipeItem[]
  processes         RecipeProcess[]
  MenuItemComponent MenuItemComponent[]

  @@map("recipes")
}

model RecipeItem {
  id        Int     @id @default(autoincrement())
  recipeId  Int
  productId Int
  quantity  Float
  unitCost  Decimal @db.Decimal(10, 2)
  totalCost Decimal @db.Decimal(10, 2)
  product   Product @relation(fields: [productId], references: [id])
  recipe    Recipe  @relation(fields: [recipeId], references: [id])

  @@map("recipe_items")
}

model RecipeProcess {
  id              Int     @id @default(autoincrement())
  recipeId        Int
  name            String
  processType     String
  duration        Float
  operators       Int
  stepDescription String?
  stepOrder       Int     @default(0) @map("order")
  recipe          Recipe  @relation(fields: [recipeId], references: [id])

  @@map("recipe_processes")
}

model Cost {
  id           Int    @id @default(autoincrement())
  name         String
  type         String
  monthlyValue Float

  @@map("costs")
}

model Config {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("config")
}

model OtherCosts {
  id                Int      @id @default(autoincrement())
  month             String
  fixedCosts        Float
  variableCosts     Float
  payroll           Float
  monthlyProduction Float?
  createdAt         DateTime @default(now())

  @@map("other_costs")
}

enum MovementType {
  PURCHASE
  TRANSFER
  WASTE
  CONSUMPTION
}

/// Coincide con el tipo PostgreSQL `ProductBaseUnit` creado en `20260326160000_product_unit_base_enum`.
enum ProductBaseUnit {
  g
  ml
  und
}

model MenuItem {
  id          Int     @id @default(autoincrement())
  name        String // nombre del plato (ej: "Hamburguesa Especial")
  description String? // acompañantes (texto libre)

  hasDrink   Boolean @default(false)
  hasDessert Boolean @default(false)

  active Boolean @default(true)

  createdAt DateTime @default(now())

  components MenuItemComponent[]
}

model MenuItemComponent {
  id Int @id @default(autoincrement())

  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  productId Int?
  product   Product? @relation(fields: [productId], references: [id])

  recipeId Int?
  recipe   Recipe? @relation(fields: [recipeId], references: [id])

  quantity Float
}
