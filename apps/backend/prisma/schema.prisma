generator client {
  provider = "prisma-client-js"
  seed     = "ts-node prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Supplier {
  id            Int       @id @default(autoincrement())
  internalCode  String
  name          String
  taxId         String
  phone         String
  address       String
  contactPerson String
  products      Product[]

  @@map("suppliers")
}

model Product {
  id                Int          @id @default(autoincrement())
  internalCode      String
  name              String
  isIngredient      Boolean
  isSupply          Boolean
  isFinishedProduct Boolean
  presentation      String
  unitOfMeasure     String
  expirationDate    DateTime?
  minStock          Float
  maxStock          Float
  currentStock      Float
  unitCost          Decimal      @db.Decimal(10, 2)
  supplierId        Int
  category          String       @default("")
  supplier          Supplier     @relation(fields: [supplierId], references: [id])
  recipeItems       RecipeItem[]

  @@map("products")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  fullName     String?
  roleId       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  active       Boolean  @default(true)
  role         Role?    @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Recipe {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  batchQuantity Float
  portions      Int

  totalCost Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  items     RecipeItem[]
  processes RecipeProcess[]

  @@map("recipes")
}

model RecipeItem {
  id        Int @id @default(autoincrement())
  recipeId  Int
  productId Int

  quantity  Float
  unitCost  Decimal @db.Decimal(10, 2)
  totalCost Decimal @db.Decimal(10, 2)

  recipe  Recipe  @relation(fields: [recipeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("recipe_items")
}

model RecipeProcess {
  id       Int @id @default(autoincrement())
  recipeId Int

  name        String
  processType String
  duration    Float
  operators   Int

  recipe Recipe @relation(fields: [recipeId], references: [id])

  @@map("recipe_processes")
}
model Cost {
  id           Int     @id @default(autoincrement())
  name         String
  type         String  // fijo | variable | impuesto
  monthlyValue Float

  @@map("costs")
}
