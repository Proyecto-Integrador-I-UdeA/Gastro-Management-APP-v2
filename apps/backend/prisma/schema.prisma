generator client {
  provider = "prisma-client-js"
  seed     = "ts-node prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MovementType {
  PURCHASE
  TRANSFER
  WASTE
  CONSUMPTION
}

model Supplier {
  id            Int       @id @default(autoincrement())
  internalCode  String
  name          String
  taxId         String
  phone         String
  address       String
  contactPerson String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]

  @@map("suppliers")
}

model Product {
  id                Int                 @id @default(autoincrement())
  internalCode      String              @unique @db.Text
  name              String              @db.Text
  category          String              @default("") @db.Text
  isIngredient      Boolean             @default(false)
  isSupply          Boolean             @default(false)
  isFinishedProduct Boolean             @default(false)
  presentation      String              @db.Text
  unitOfMeasure     String              @db.Text
  inputUnit         String              @default("g") @db.Text
  inputUnitQuantity Float               @default(1)
  minStock          Float
  maxStock          Float
  active            Boolean             @default(true)
  supplierId        Int
  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  inventories       Inventory[]
  movements         InventoryMovement[]
  recipeItems       RecipeItem[]

  @@map("products")
}

model Warehouse {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  description       String?
  /// Solo una bodega puede ser principal (entradas por compra).
  isMain            Boolean             @default(false)
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  inventories       Inventory[]
  movementsAsSource InventoryMovement[] @relation("SourceWarehouse")
  movementsAsDest   InventoryMovement[] @relation("DestinationWarehouse")

  @@map("warehouses")
}

model Inventory {
  id          Int       @id @default(autoincrement())
  quantity    Float     @default(0)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@map("inventories")
}

model InventoryMovement {
  id                     Int          @id @default(autoincrement())
  type                   MovementType
  quantity               Float
  unitCost               Decimal?     @db.Decimal(10, 2)
  expirationDate         DateTime?
  notes                  String?
  productId              Int
  product                Product      @relation(fields: [productId], references: [id])
  sourceWarehouseId      Int?
  sourceWarehouse        Warehouse?   @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationWarehouseId Int?
  destinationWarehouse   Warehouse?   @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  userId                 Int
  user                   User         @relation(fields: [userId], references: [id])
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@map("inventory_movements")
}

model User {
  id           Int                 @id @default(autoincrement())
  email        String              @unique
  passwordHash String
  fullName     String?
  roleId       Int?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  active       Boolean             @default(true)
  role         Role?               @relation(fields: [roleId], references: [id])
  movements    InventoryMovement[]

  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Recipe {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  batchQuantity Float
  portions      Int

  totalCost Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  items     RecipeItem[]
  processes RecipeProcess[]

  @@map("recipes")
}

model RecipeItem {
  id        Int @id @default(autoincrement())
  recipeId  Int
  productId Int

  quantity  Float
  unitCost  Decimal @db.Decimal(10, 2)
  totalCost Decimal @db.Decimal(10, 2)

  recipe  Recipe  @relation(fields: [recipeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("recipe_items")
}

model RecipeProcess {
  id              Int    @id @default(autoincrement())
  recipeId        Int
  name            String
  processType     String
  duration        Float
  operators       Int
  stepDescription String?
  stepOrder       Int    @default(0) @map("order")

  recipe Recipe @relation(fields: [recipeId], references: [id])

  @@map("recipe_processes")
}

model Cost {
  id           Int     @id @default(autoincrement())
  name         String
  type         String // fijo | variable | impuesto
  monthlyValue Float

  @@map("costs")
}

model Config {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("config")
}

model OtherCosts {
  id                Int      @id @default(autoincrement())
  month             String
  fixedCosts        Float
  variableCosts     Float
  payroll           Float
  monthlyProduction Float?
  createdAt         DateTime @default(now())

  @@map("other_costs")
}
