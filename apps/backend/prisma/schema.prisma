generator client {
  provider = "prisma-client-js"
  seed     = "ts-node prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Supplier {
  id            Int       @id @default(autoincrement())
  internalCode  String    @unique
  name          String
  taxId         String
  phone         String
  address       String
  contactPerson String
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now())
  products      Product[]

  @@map("suppliers")
}

model IngredientCatalog {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  category String?

  caloriesPer100g Float?
  carbsPer100g    Float?
  fatPer100g      Float?
  proteinPer100g  Float?
  sugarPer100g    Float?
  sodiumPer100g   Float?

  isSystem Boolean @default(false)

  products Product[]
}

model Product {
  id                Int     @id @default(autoincrement())
  internalCode      String  @unique
  name              String
  category          String  @default("")
  isIngredient      Boolean @default(false)
  isSupply          Boolean @default(false)
  isFinishedProduct Boolean @default(false)
  presentation      String
  inputUnit         String  @default("g")
  inputUnitQuantity Float   @default(1)
  minStock          Float
  maxStock          Float
  currentStock      Float   @default(0)
  unitCost          Float   @default(0)
  active            Boolean @default(true)
  supplierId        Int

  catalogId Int?
  catalog   IngredientCatalog? @relation(fields: [catalogId], references: [id])

  caloriesPer100g    Float?
  carbsPer100g       Float?
  fatPer100g         Float?
  proteinPer100g     Float?
  sodiumPer100g      Float?
  sugarPer100g       Float?
  isSeedProduct      Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now())
  unitOfMeasure      ProductBaseUnit     @default(g)
  MenuItemComponent  MenuItemComponent[]
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  recipeItems        RecipeItem[]        @relation("ProductRecipeItems")

  @@map("products")
}

model Warehouse {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  description       String?
  /// Solo una bodega puede ser principal (entradas por compra).
  isMain            Boolean             @default(false)
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  inventories       Inventory[]
  movementsAsDest   InventoryMovement[] @relation("DestinationWarehouse")
  movementsAsSource InventoryMovement[] @relation("SourceWarehouse")

  @@map("warehouses")
}

model Inventory {
  id          Int       @id @default(autoincrement())
  quantity    Float     @default(0)
  productId   Int
  warehouseId Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@map("inventories")
}

model InventoryMovement {
  id                     Int          @id @default(autoincrement())
  type                   MovementType
  quantity               Float
  unitCost               Decimal?     @db.Decimal(10, 2)
  expirationDate         DateTime?
  notes                  String?
  productId              Int
  sourceWarehouseId      Int?
  destinationWarehouseId Int?
  userId                 Int
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @default(now()) @updatedAt
  destinationWarehouse   Warehouse?   @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  product                Product      @relation(fields: [productId], references: [id])
  sourceWarehouse        Warehouse?   @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  user                   User         @relation(fields: [userId], references: [id])

  @@map("inventory_movements")
}

model User {
  id           Int                 @id @default(autoincrement())
  email        String              @unique
  passwordHash String
  fullName     String?
  roleId       Int?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt
  active       Boolean             @default(true)
  movements    InventoryMovement[]
  role         Role?               @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now())
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Recipe {
  id            Int      @id @default(autoincrement())
  internalCode  String   @unique
  active        Boolean  @default(true)
  name          String
  description   String?
  batchQuantity Float
  portions      Int
  totalCost     Decimal? @db.Decimal(10, 2)

  caloriesPerPortion Float?
  proteinPerPortion  Float?
  carbsPerPortion    Float?
  fatPerPortion      Float?
  sodiumPerPortion   Float?
  sugarPerPortion    Float?
  nutritionScore     Float?

  macroDominance     String?
  nutritionRole      String?
  costClassification String?

  createdAt         DateTime            @default(now())
  MenuItemComponent MenuItemComponent[]

  items           RecipeItem[] @relation("ParentRecipe")
  usedAsSubRecipe RecipeItem[] @relation("SubRecipeReference")

  processes RecipeProcess[]

  @@map("recipes")
}

model RecipeItem {
  id          Int  @id @default(autoincrement())
  recipeId    Int
  productId   Int?
  subRecipeId Int?

  quantity  Float
  unitCost  Decimal @db.Decimal(10, 2)
  totalCost Decimal @db.Decimal(10, 2)

  product Product? @relation("ProductRecipeItems", fields: [productId], references: [id])

  recipe Recipe @relation("ParentRecipe", fields: [recipeId], references: [id])

  subRecipe Recipe? @relation("SubRecipeReference", fields: [subRecipeId], references: [id])

  @@map("recipe_items")
}

model RecipeProcess {
  id              Int     @id @default(autoincrement())
  recipeId        Int
  name            String
  processType     String
  duration        Float
  operators       Int
  stepDescription String?
  stepOrder       Int     @default(0) @map("order")
  recipe          Recipe  @relation(fields: [recipeId], references: [id])

  @@map("recipe_processes")
}

model Cost {
  id           Int    @id @default(autoincrement())
  name         String
  type         String
  monthlyValue Float

  @@map("costs")
}

model Config {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("config")
}

model OtherCosts {
  id                Int      @id @default(autoincrement())
  month             String
  fixedCosts        Float
  variableCosts     Float
  payroll           Float
  monthlyProduction Float?
  createdAt         DateTime @default(now())

  @@map("other_costs")
}

model MenuItem {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  hasDrink    Boolean @default(false)
  hasDessert  Boolean @default(false)
  active      Boolean @default(true)

  totalCost Decimal? @db.Decimal(10, 2)

  caloriesPerPortion Float?
  proteinPerPortion  Float?
  carbsPerPortion    Float?
  fatPerPortion      Float?
  sodiumPerPortion   Float?
  sugarPerPortion    Float?

  nutritionScore Float?

  createdAt  DateTime            @default(now())
  components MenuItemComponent[]
}

model MenuItemComponent {
  id         Int      @id @default(autoincrement())
  menuItemId Int
  productId  Int?
  recipeId   Int?
  quantity   Float
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  product    Product? @relation(fields: [productId], references: [id])
  recipe     Recipe?  @relation(fields: [recipeId], references: [id])
}

enum MovementType {
  PURCHASE
  TRANSFER
  WASTE
  CONSUMPTION
}

enum ProductBaseUnit {
  g
  ml
  und
}
